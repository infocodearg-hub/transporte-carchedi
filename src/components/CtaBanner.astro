---
import { contacto, linkWhatsApp } from '../data/site';
import Icono from './Icono.astro';
import IconoRed from './IconoRed.astro';
---

<section class="bg-rojo py-14 text-white sm:py-16">
  <div class="contenedor reveal flex flex-col items-start gap-8 lg:flex-row lg:items-center lg:justify-between">
    <div>
      <h2 class="text-4xl text-white sm:text-5xl">Hacé tu consulta o reservá ahora</h2>
      <p class="mt-3 text-lg text-white/90">
        {contacto.horario}. WhatsApp habilitado las 24 horas para urgencias.
      </p>
    </div>

    <div class="flex shrink-0 flex-col gap-3 sm:flex-row">
      <a
        href={linkWhatsApp('Hola, necesito reservar un camión.')}
        target="_blank"
        rel="noopener noreferrer"
        class="btn bg-white text-carbon hover:bg-carbon hover:text-white"
      >
        <IconoRed nombre="WhatsApp" class="h-5 w-5 text-verde-wa" />
        Reservar por WhatsApp
      </a>
      <a href={`tel:${contacto.oficinaTel}`} class="btn border border-white/70 text-white hover:bg-white hover:text-rojo">
        <Icono nombre="telefono" class="h-5 w-5" />
        {contacto.oficina}
      </a>
    </div>
  </div>
</section>
