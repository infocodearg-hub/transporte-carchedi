---
import { contacto, redes, empresa } from '../data/site';
import Icono from './Icono.astro';
import IconoRed from './IconoRed.astro';
---

<section id="contacto" class="bg-gris-50 py-20 sm:py-28">
  <div class="contenedor">
    <div class="reveal max-w-3xl">
      <h2 class="titulo-seccion filete">Estamos para ayudarte</h2>
      <p class="mt-8 text-lg">
        Contanos qué necesitás mover y te respondemos con la unidad que mejor se adapta y su tarifa.
      </p>
    </div>

    <div class="mt-12 grid gap-10 lg:grid-cols-2 lg:gap-14">
      <!-- Formulario: arma el mensaje y lo abre en WhatsApp, que es donde atienden las 24 horas. -->
      <div class="reveal rounded-sm bg-white p-7 ring-1 ring-gris-200 sm:p-9">
        <h3 class="text-2xl">Escribinos</h3>
        <p class="mt-2 text-sm text-gris-600">
          Los campos marcados con <span class="text-rojo">*</span> son obligatorios. Al enviar se
          abre WhatsApp con tu consulta ya escrita.
        </p>

        <form id="form-consulta" class="mt-7 space-y-5" novalidate>
          <div>
            <label for="nombre" class="mb-1.5 block font-cond text-lg font-semibold uppercase tracking-wide text-carbon">
              Nombre <span class="text-rojo">*</span>
            </label>
            <input
              type="text"
              id="nombre"
              name="nombre"
              required
              autocomplete="name"
              class="w-full rounded-sm border border-gris-200 bg-white px-4 py-3 text-carbon transition-colors focus:border-rojo focus:outline-none"
            />
            <p class="error mt-1 hidden text-sm text-rojo" data-error-de="nombre" role="alert"></p>
          </div>

          <div>
            <label for="email" class="mb-1.5 block font-cond text-lg font-semibold uppercase tracking-wide text-carbon">
              Email <span class="text-rojo">*</span>
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              autocomplete="email"
              class="w-full rounded-sm border border-gris-200 bg-white px-4 py-3 text-carbon transition-colors focus:border-rojo focus:outline-none"
            />
            <p class="error mt-1 hidden text-sm text-rojo" data-error-de="email" role="alert"></p>
          </div>

          <div>
            <label for="telefono" class="mb-1.5 block font-cond text-lg font-semibold uppercase tracking-wide text-carbon">
              Teléfono
            </label>
            <input
              type="tel"
              id="telefono"
              name="telefono"
              autocomplete="tel"
              inputmode="tel"
              class="w-full rounded-sm border border-gris-200 bg-white px-4 py-3 text-carbon transition-colors focus:border-rojo focus:outline-none"
            />
          </div>

          <div>
            <label for="consulta" class="mb-1.5 block font-cond text-lg font-semibold uppercase tracking-wide text-carbon">
              Consulta <span class="text-rojo">*</span>
            </label>
            <textarea
              id="consulta"
              name="consulta"
              rows="5"
              required
              placeholder="Qué necesitás mover, desde dónde y hasta dónde."
              class="w-full rounded-sm border border-gris-200 bg-white px-4 py-3 text-carbon transition-colors placeholder:text-gris-400 focus:border-rojo focus:outline-none"
            ></textarea>
            <p class="error mt-1 hidden text-sm text-rojo" data-error-de="consulta" role="alert"></p>
          </div>

          <button type="submit" class="btn-wa w-full">
            <IconoRed nombre="WhatsApp" class="h-5 w-5" />
            Enviar por WhatsApp
          </button>
        </form>
      </div>

      <!-- Datos completos -->
      <div class="reveal">
        <ul class="space-y-6">
          <li class="flex gap-4">
            <span class="mt-0.5 shrink-0 text-rojo"><Icono nombre="pin" class="h-6 w-6" /></span>
            <div>
              <h3 class="text-xl">Dirección</h3>
              <a href={contacto.mapa} target="_blank" rel="noopener noreferrer" class="hover:text-rojo">
                {contacto.direccion}
              </a>
            </div>
          </li>

          <li class="flex gap-4">
            <span class="mt-0.5 shrink-0 text-rojo"><Icono nombre="telefono" class="h-6 w-6" /></span>
            <div>
              <h3 class="text-xl">Teléfonos</h3>
              <p>
                Oficina: <a href={`tel:${contacto.oficinaTel}`} class="hover:text-rojo">{contacto.oficina}</a>
              </p>
              <p>
                Celular: <a href={`tel:${contacto.celularTel}`} class="hover:text-rojo">{contacto.celular}</a>
              </p>
            </div>
          </li>

          <li class="flex gap-4">
            <span class="mt-0.5 shrink-0 text-rojo"><Icono nombre="mail" class="h-6 w-6" /></span>
            <div>
              <h3 class="text-xl">Email</h3>
              {/* PENDIENTE: confirmar si el mail va en .com o .com.ar. Ver src/data/site.ts */}
              <a href={`mailto:${contacto.email}`} class="hover:text-rojo">{contacto.email}</a>
            </div>
          </li>

          <li class="flex gap-4">
            <span class="mt-0.5 shrink-0 text-rojo"><Icono nombre="reloj" class="h-6 w-6" /></span>
            <div>
              <h3 class="text-xl">Horario de atención</h3>
              <p>{contacto.horario}</p>
              <p class="text-gris-600">{contacto.horarioNota}</p>
            </div>
          </li>

          <li class="flex gap-4">
            <span class="mt-0.5 shrink-0 text-rojo"><Icono nombre="camion" class="h-6 w-6" /></span>
            <div>
              <h3 class="text-xl">Zona de operación</h3>
              <p>{empresa.zona}</p>
            </div>
          </li>
        </ul>

        <div class="mt-8 border-t border-gris-200 pt-6">
          <h3 class="text-xl">Seguinos</h3>
          <ul class="mt-3 flex gap-3">
            {
              redes.map((red) => (
                <li>
                  <a
                    href={red.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex h-11 w-11 items-center justify-center rounded-sm bg-carbon text-white transition-colors hover:bg-rojo"
                  >
                    <IconoRed nombre={red.nombre} class="h-5 w-5" />
                    <span class="sr-only">{red.nombre}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>

    <div class="reveal mt-12 overflow-hidden rounded-sm ring-1 ring-gris-200">
      <iframe
        src={contacto.mapaEmbed}
        title={`Ubicación de ${empresa.nombre} en ${contacto.localidad}`}
        width="100%"
        height="380"
        style="border:0"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen></iframe>
    </div>
  </div>
</section>

<script>
  import { contacto } from '../data/site';

  const form = document.getElementById('form-consulta') as HTMLFormElement | null;

  if (form) {
    const mostrarError = (campo: string, mensaje: string) => {
      const p = form.querySelector<HTMLElement>(`[data-error-de="${campo}"]`);
      const input = form.elements.namedItem(campo) as HTMLInputElement | null;
      if (p) {
        p.textContent = mensaje;
        p.classList.toggle('hidden', !mensaje);
      }
      input?.setAttribute('aria-invalid', mensaje ? 'true' : 'false');
      input?.classList.toggle('border-rojo', Boolean(mensaje));
    };

    form.addEventListener('submit', (evento) => {
      evento.preventDefault();
      const datos = new FormData(form);
      const nombre = String(datos.get('nombre') ?? '').trim();
      const email = String(datos.get('email') ?? '').trim();
      const telefono = String(datos.get('telefono') ?? '').trim();
      const consulta = String(datos.get('consulta') ?? '').trim();

      let hayError = false;
      mostrarError('nombre', '');
      mostrarError('email', '');
      mostrarError('consulta', '');

      if (!nombre) {
        mostrarError('nombre', 'Escribí tu nombre.');
        hayError = true;
      }
      if (!email) {
        mostrarError('email', 'Escribí tu email.');
        hayError = true;
      } else if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) {
        mostrarError('email', 'Revisá el email: parece incompleto.');
        hayError = true;
      }
      if (!consulta) {
        mostrarError('consulta', 'Contanos qué necesitás mover.');
        hayError = true;
      }

      if (hayError) {
        form.querySelector<HTMLElement>('[aria-invalid="true"]')?.focus();
        return;
      }

      const lineas = [
        'Hola, les escribo desde la web.',
        '',
        `Nombre: ${nombre}`,
        `Email: ${email}`,
        telefono ? `Teléfono: ${telefono}` : null,
        '',
        `Consulta: ${consulta}`,
      ].filter((linea): linea is string => linea !== null);

      const url = `https://api.whatsapp.com/send?phone=${contacto.whatsappNumero}&text=${encodeURIComponent(
        lineas.join('\n'),
      )}`;
      window.open(url, '_blank', 'noopener');
    });
  }
</script>
