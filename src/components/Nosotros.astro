---
import { Image } from 'astro:assets';
import flotaFoto from '../assets/fotos/nosotros-flota.jpg';
import cabaFoto from '../assets/fotos/nosotros-caba.jpg';
import cargaFoto from '../assets/fotos/nosotros-carga.jpg';
import { pilares } from '../data/servicios';
import Icono from './Icono.astro';
---

<!-- Fondo gris muy claro. El sitio viejo tenía páginas enteras en amarillo fuerte: se sacó. -->
<section id="nosotros" class="bg-gris-50 py-20 sm:py-28">
  <div class="contenedor">
    <div class="grid items-start gap-12 lg:grid-cols-[1.1fr_1fr] lg:gap-16">
      <div class="reveal">
        <h2 class="titulo-seccion filete">Expertos en transporte de carga</h2>
        <p class="mt-8 text-lg leading-relaxed">
          Somos una <strong class="font-semibold text-carbon"
            >empresa familiar con más de 10 años de experiencia en el ámbito de transporte y
            logística</strong
          >. Nuestro mayor fuerte es ofrecer excelencia en <strong class="font-semibold text-carbon"
            >servicio de pala hidráulica y mercaderías peligrosas en todo Capital Federal y Gran
            Buenos Aires</strong
          >. Nuestro mayor objetivo es fidelizar al cliente, demostrándole día tras día la calidad
          de proveedor que podemos ser, tanto en lo personal como en la cantidad y variedad de
          vehículos nuevos que tenemos para realizar su carga con <strong
            class="font-semibold text-carbon">seguridad y confiabilidad</strong
          >.
        </p>
      </div>

      <div class="reveal grid grid-cols-2 gap-3 sm:gap-4">
        <Image
          src={flotaFoto}
          alt="Varias unidades de la flota de Transporte Carchedi estacionadas en el depósito"
          widths={[320, 640]}
          sizes="(min-width: 1024px) 260px, 45vw"
          class="col-span-2 h-52 w-full rounded-sm object-cover sm:h-64"
          loading="lazy"
        />
        <Image
          src={cabaFoto}
          alt="Camión de Transporte Carchedi descargando en el centro de la Ciudad de Buenos Aires"
          widths={[280, 560]}
          sizes="(min-width: 1024px) 130px, 22vw"
          class="h-36 w-full rounded-sm object-cover sm:h-44"
          loading="lazy"
        />
        <Image
          src={cargaFoto}
          alt="Peones de Transporte Carchedi cargando mercadería en el furgón del camión"
          widths={[280, 560]}
          sizes="(min-width: 1024px) 130px, 22vw"
          class="h-36 w-full rounded-sm object-cover sm:h-44"
          loading="lazy"
        />
      </div>
    </div>

    <ul class="mt-16 grid gap-6 sm:mt-20 sm:grid-cols-2 lg:grid-cols-3">
      {
        pilares.map((pilar) => (
          <li class="reveal border-t-2 border-gris-200 bg-white p-7 transition-colors duration-200 hover:border-rojo">
            <span class="inline-flex text-rojo">
              <Icono nombre={pilar.icono} class="h-8 w-8" />
            </span>
            <h3 class="mt-4 text-2xl">{pilar.titulo}</h3>
            <p class="mt-3 text-[15px] leading-relaxed">{pilar.texto}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
