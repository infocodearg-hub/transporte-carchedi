---
import { Image } from 'astro:assets';
import { servicios, listaServicio, listaHabilitaciones } from '../data/servicios';
import { waPrincipal, linkWhatsApp } from '../data/site';
import Icono from './Icono.astro';
import IconoRed from './IconoRed.astro';
---

<section id="servicios" class="py-20 sm:py-28">
  <div class="contenedor">
    <div class="reveal max-w-3xl">
      <h2 class="titulo-seccion filete">Servicios de camiones de carga</h2>
      <p class="mt-8 text-lg">
        Transporte de cargas generales, cargas peligrosas, cargas con SENASA, cargas refrigeradas y
        más.
      </p>
    </div>

    <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        servicios.map((servicio) => (
          <li class="reveal group flex overflow-hidden rounded-sm bg-white shadow-[0_1px_3px_rgba(0,0,0,.12)] ring-1 ring-gris-100 transition-shadow duration-200 hover:shadow-lg">
            {servicio.texto && servicio.foto ? (
              /* Tarjeta completa: foto arriba, título y texto abajo. */
              <article class="flex flex-col">
                <Image
                  src={servicio.foto}
                  alt={servicio.alt}
                  widths={[400, 800]}
                  sizes="(min-width: 1024px) 380px, (min-width: 640px) 45vw, 90vw"
                  class="aspect-[16/9] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                  loading="lazy"
                />
                <div class="flex flex-1 flex-col p-6">
                  <h3 class="text-2xl">{servicio.titulo}</h3>
                  <p class="mt-3 text-[15px] leading-relaxed">{servicio.texto}</p>
                </div>
              </article>
            ) : servicio.foto ? (
              /*
                Las dos categorías sin texto van con la foto a toda la altura y el título sobre un
                degradado: la tarjeta se ve completa y no queda el hueco donde iría el párrafo.
              */
              <article class="relative flex min-h-[320px] w-full flex-col justify-end">
                <Image
                  src={servicio.foto}
                  alt={servicio.alt}
                  widths={[400, 800]}
                  sizes="(min-width: 1024px) 380px, (min-width: 640px) 45vw, 90vw"
                  class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-carbon via-carbon/55 to-transparent" />
                <h3 class="relative p-6 text-2xl text-white">{servicio.titulo}</h3>
              </article>
            ) : (
              /*
                PENDIENTE: no hay ninguna foto de una unidad con hidrogrúa en el material.
                La tarjeta va sobre fondo oscuro con ícono hasta que el cliente la provea.
              */
              <article class="flex flex-1 flex-col bg-carbon p-6 text-gris-200">
                <span class="mb-4 inline-flex text-rojo">
                  <Icono nombre={servicio.icono!} class="h-10 w-10" />
                </span>
                <h3 class="text-2xl text-white">{servicio.titulo}</h3>
                <p class="mt-3 text-[15px] leading-relaxed">{servicio.texto}</p>
              </article>
            )}
          </li>
        ))
      }
    </ul>

    <!-- Las dos listas, en dos columnas -->
    <div class="reveal mt-16 grid gap-10 border-t border-gris-200 pt-12 sm:grid-cols-2 sm:gap-16">
      <div>
        <h3 class="text-3xl">Servicio</h3>
        <ul class="mt-6 space-y-3">
          {
            listaServicio.map((item) => (
              <li class="flex gap-3">
                <Icono nombre="check" class="mt-1 h-4 w-4 shrink-0 text-rojo" />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3 class="text-3xl">Vehículos y habilitaciones</h3>
        <ul class="mt-6 space-y-3">
          {
            listaHabilitaciones.map((item) => (
              <li class="flex gap-3">
                <Icono nombre="check" class="mt-1 h-4 w-4 shrink-0 text-rojo" />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- Cómo trabajamos: sobre fondo oscuro para diferenciarlo del resto de servicios. -->
<section class="bg-carbon py-20 text-gris-200 sm:py-24">
  <div class="contenedor">
    <div class="reveal grid gap-10 lg:grid-cols-[1fr_1.4fr] lg:gap-16">
      <div>
        <h2 class="titulo-seccion filete text-white">Cómo trabajamos</h2>
        <a
          href={linkWhatsApp('Hola, quería hacer una consulta sobre un traslado.')}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-wa mt-8 hidden lg:inline-flex"
        >
          <IconoRed nombre="WhatsApp" class="h-5 w-5" />
          Hacé tu consulta
        </a>
      </div>

      <div class="space-y-5 text-lg leading-relaxed">
        <p>
          Tenemos una modalidad de trabajo muy práctica para solucionar los problemas de tiempo,
          logísticos y de costos de nuestros clientes. Una vez que nos contactan les informamos
          tarifas, formas de realizar el trabajo y todos los datos de la empresa, el vehículo y el
          chofer. Garantizamos todos nuestros trabajos: bajamos costos, ganamos tiempo, cuidamos su
          mercadería y entregamos en tiempo y forma toda la carga.
        </p>
        <p>
          En Transporte Carchedi garantizamos la satisfacción de nuestros clientes. Ofrecemos
          soluciones espontáneas y planificadas que les permitan lograr una ventaja, reduciendo
          tiempo y con un precio muy competitivo dentro del mercado del transporte. Para desarrollar
          esta tarea contamos con la mejor atención y tecnología, para adaptarnos a las peticiones
          del cliente y sus necesidades. Ofrecemos seguridad, tranquilidad, puntualidad y
          versatilidad para personalizar el servicio según el trabajo a realizar.
        </p>
        <p>
          Contamos con personal preparado para solucionar todo tipo de problemas logísticos.
          Soluciones al instante, rápidas y eficaces. Estamos preparados tanto en lo administrativo
          como en lo logístico: vehículos 0 km, herramientas de trabajo, ropa de trabajo y seguros
          de camión, personal y mercadería, para garantizarle el mejor traslado de su mercadería.
          Nuestra forma de operar es ordenada, prolija, segura y con ganas de que nuestros clientes
          sigan progresando.
        </p>

        <a
          href={waPrincipal}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-wa mt-2 inline-flex lg:hidden"
        >
          <IconoRed nombre="WhatsApp" class="h-5 w-5" />
          Hacé tu consulta
        </a>
      </div>
    </div>
  </div>
</section>
