---
import Icono from './Icono.astro';

// Los rombos de riesgo son señalización normalizada de Naciones Unidas, no una marca: se pueden
// dibujar. Los logos de CNRT y SENASA sí son marcas de organismos públicos y NO se recrean ni se
// descargan de internet.
//
// Clase 8: mitad superior blanca y mitad inferior negra, con el número en blanco.
// Clase 9: fondo blanco con siete franjas verticales negras arriba y el número subrayado.
// Clase 2 inflamable: fondo rojo con el número en blanco.
const rombos = [
  { clase: '8', nombre: 'Corrosivos', tipo: 'mitades' },
  { clase: '9', nombre: 'Sustancias y objetos peligrosos varios', tipo: 'franjas' },
  { clase: '2', nombre: 'Gases inflamables', tipo: 'pleno' },
] as const;

const bloques = [
  {
    titulo: 'CNRT',
    subtitulo: 'Cargas generales',
    texto:
      'Habilitación de la Comisión Nacional de Regulación del Transporte para el transporte de cargas generales.',
  },
  {
    titulo: 'SENASA',
    subtitulo: 'Cargas con SENASA',
    texto:
      'Habilitación del Servicio Nacional de Sanidad y Calidad Agroalimentaria para el traslado de cargas bajo su control.',
  },
];
---

<section id="habilitaciones" class="bg-carbon py-20 text-gris-200 sm:py-28">
  <div class="contenedor">
    <div class="reveal max-w-3xl">
      <h2 class="titulo-seccion filete text-white">Habilitaciones</h2>
      <p class="mt-8 text-lg">Nuestras unidades están habilitadas para:</p>
    </div>

    <div class="mt-12 grid gap-6 lg:grid-cols-3">
      {
        bloques.map((bloque) => (
          <article class="reveal flex flex-col border-t-2 border-rojo bg-carbon-2 p-7">
            {/*
              PENDIENTE: falta el logo oficial de este organismo. Es marca de un organismo público:
              no se descarga de internet ni se recrea. Se pide al cliente y se coloca acá.
            */}
            <div class="flex h-20 items-center">
              <span class="font-cond text-4xl font-bold uppercase tracking-tight text-white">
                {bloque.titulo}
              </span>
            </div>
            <h3 class="mt-4 text-2xl text-white">{bloque.subtitulo}</h3>
            <p class="mt-3 text-[15px] leading-relaxed">{bloque.texto}</p>
          </article>
        ))
      }

      <article class="reveal flex flex-col border-t-2 border-rojo bg-carbon-2 p-7">
        <ul class="flex h-20 items-center gap-3">
          {
            rombos.map((rombo) => (
              <li>
                <svg
                  viewBox="0 0 48 48"
                  class="h-16 w-16"
                  role="img"
                  aria-label={`Rombo de riesgo clase ${rombo.clase}: ${rombo.nombre}`}
                >
                  <clipPath id={`rombo-${rombo.clase}`}>
                    <path d="M24 2 46 24 24 46 2 24z" />
                  </clipPath>

                  <g clip-path={`url(#rombo-${rombo.clase})`}>
                    <rect
                      x="0"
                      y="0"
                      width="48"
                      height="48"
                      fill={rombo.tipo === 'pleno' ? '#d9232a' : '#ffffff'}
                    />
                    {rombo.tipo === 'mitades' && <rect x="0" y="24" width="48" height="24" fill="#1a1919" />}
                    {rombo.tipo === 'franjas' &&
                      [7, 13, 19, 25, 31, 37, 43].map((x) => (
                        <rect x={x} y="0" width="2" height="24" fill="#1a1919" />
                      ))}
                  </g>

                  {/* Contorno exterior en blanco: sobre el fondo carbón, uno negro se perdería. */}
                  <path d="M24 2 46 24 24 46 2 24z" fill="none" stroke="#ffffff" stroke-width="1.5" />
                  <path
                    d="M24 6 42 24 24 42 6 24z"
                    fill="none"
                    stroke={rombo.tipo === 'pleno' ? '#ffffff' : '#1a1919'}
                    stroke-width="1.2"
                  />

                  <text
                    x="24"
                    y="37"
                    text-anchor="middle"
                    font-size="13"
                    font-weight="700"
                    fill={rombo.tipo === 'franjas' ? '#1a1919' : '#ffffff'}
                    font-family="Barlow Condensed, Barlow, sans-serif"
                  >
                    {rombo.clase}
                  </text>
                  {rombo.tipo === 'franjas' && (
                    <path d="M20.5 39h7" stroke="#1a1919" stroke-width="1.2" />
                  )}
                </svg>
              </li>
            ))
          }
        </ul>
        <h3 class="mt-4 text-2xl text-white">Carga peligrosa</h3>
        <p class="mt-3 text-[15px] leading-relaxed">
          Habilitación para cargas peligrosas de clase 8, clase 9 y clase 2 inflamable. Vehículos y
          chóferes con toda la documentación al día.
        </p>
      </article>
    </div>

    <p class="reveal mt-8 flex items-center gap-3 text-lg text-white">
      <Icono nombre="check" class="h-5 w-5 shrink-0 text-rojo" />
      <span>
        Contamos además con habilitación para <strong class="font-semibold">residuos especiales</strong>.
      </span>
    </p>
  </div>
</section>
